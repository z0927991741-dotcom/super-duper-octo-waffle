{
  "name": "dream-mender",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/core.test.mjs tests/gps.test.mjs tests/field.test.mjs tests/building-collision.test.mjs",
    "test:e2e": "playwright test",
    "build:standalone": "node scripts/build-standalone.mjs",
    "build:web": "node scripts/build-standalone.mjs && node scripts/build-web.mjs",
    "test:web-startup": "python tests/web-startup-browser.py"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "0.1.4",
    "leaflet": "1.9.4",
    "maplibre-gl": "5.10.0"
  }
}
